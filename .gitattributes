# Normalización de fin de línea: el repositorio guarda LF.
# Windows puede trabajar con CRLF localmente; Linux/Docker recibe LF.
* text=auto eol=lf

# Scripts de Windows conservan CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios: nunca convertir.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.xlsx binary
*.xls binary
*.pdf binary
*.woff binary
*.woff2 binary
